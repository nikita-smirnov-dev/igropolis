---
import { Icon } from 'astro-icon/components';

import PersonalTabGames from '@/components/base/PersonalTabGames.astro';
import { personalNavItems } from '@/data/data';
import PersonalTabCollections from '@/components/base/PersonalTabCollections.astro';
import PersonalTabBookmarks from '@/components/base/PersonalTabBookmarks.astro';
import PersonalTabTestimonials from '@/components/base/PersonalTabTestimonials.astro';
import PersonalTabComments from '@/components/base/PersonalTabComments.astro';
import PersonalTabSubscriptions from '@/components/base/PersonalTabSubscriptions.astro';
import PersonalTabSubscribers from '@/components/base/PersonalTabSubscribers.astro';
---

<section class="personal-content section-offset">
  <div class="container">
    <div class="content-wrapper grid">
      <div class="personal-content__mobile-menu">
        <nav
          class="personal-content__nav personal-nav"
          data-tabs
          data-scroll-nav
          aria-label="Навигация по личному кабинету"
        >
          <button
            class="btn-reset personal-nav__scroll-btn personal-nav__scroll-btn--prev"
            data-scroll-btn="left"
            aria-label="Прокрутить влево"
          >
            <Icon name="angle-left" aria-hidden="true" />
          </button>
          <ul class="list-reset personal-nav__list" data-scroll-list>
            {
              personalNavItems.map((item) => (
                <li class="personal-nav__item">
                  <button
                    class={`btn-reset personal-nav__btn ${item.tab === 1 ? 'is-active' : ''}`}
                    data-tab={item.tab}
                    role="tab"
                    aria-selected={item.tab === 1 ? 'true' : 'false'}
                    tabindex={item.tab === 1 ? '0' : '-1'}
                    id={`tab-${item.tab}`}
                  >
                    {item.title}
                    <span class="personal-nav__count">{item.count}</span>
                  </button>
                </li>
              ))
            }
          </ul>
          <button
            class="btn-reset personal-nav__scroll-btn personal-nav__scroll-btn--next"
            data-scroll-btn="right"
            aria-label="Прокрутить вправо"
          >
            <Icon name="angle-right" aria-hidden="true" />
          </button>
        </nav>
      </div>

      <div class="personal-content__aside">
        <nav
          class="personal-content__nav personal-nav personal-nav--sticky"
          data-tabs
          aria-label="Навигация по личному кабинету"
        >
          <ul class="list-reset personal-nav__list">
            {
              personalNavItems.map((item) => (
                <li class="personal-nav__item">
                  <button
                    class={`btn-reset personal-nav__btn ${item.tab === 1 ? 'is-active' : ''}`}
                    data-tab={item.tab}
                    role="tab"
                    aria-selected={item.tab === 1 ? 'true' : 'false'}
                    tabindex={item.tab === 1 ? '0' : '-1'}
                    id={`tab-${item.tab}`}
                  >
                    {item.title}
                    <span class="personal-nav__count">{item.count}</span>
                  </button>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
      <div class="personal-content__wrapper">
        <div
          class="personal-content__item is-active"
          role="tabpanel"
          aria-labelledby="tab-1"
          data-target="1"
        >
          <PersonalTabGames visibleItems={6} />
        </div>
        <div
          class="personal-content__item"
          role="tabpanel"
          aria-labelledby="tab-2"
          data-target="2"
        >
          <PersonalTabCollections visibleItems={6} />
        </div>
        <div
          class="personal-content__item"
          role="tabpanel"
          aria-labelledby="tab-3"
          data-target="3"
        >
          <PersonalTabBookmarks visibleItems={6} />
        </div>
        <div
          class="personal-content__item"
          role="tabpanel"
          aria-labelledby="tab-4"
          data-target="4"
        >
          <PersonalTabTestimonials visibleItems={6} />
        </div>
        <div
          class="personal-content__item"
          role="tabpanel"
          aria-labelledby="tab-5"
          data-target="5"
        >
          <PersonalTabComments visibleItems={6} userId={3} />
        </div>
        <div
          class="personal-content__item"
          role="tabpanel"
          aria-labelledby="tab-6"
          data-target="6"
        >
          <PersonalTabSubscriptions />
        </div>
        <div
          class="personal-content__item"
          role="tabpanel"
          aria-labelledby="tab-7"
          data-target="7"
        >
          <PersonalTabSubscribers />
        </div>
      </div>
    </div>
  </div>
</section>
