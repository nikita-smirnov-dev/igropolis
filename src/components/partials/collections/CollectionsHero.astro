---
import Breadcrumbs from '@/components/base/Breadcrumbs.astro';

const items = [
  { href: '/', label: 'Главная' },
  { href: '/collections/', label: 'Подборки' },
];
---

<section class="collections-hero hero">
  <div class="container">
    <div class="content-wrapper">
      <Breadcrumbs items={items} />
      <h1 class="hero__title">Подборки</h1>
    </div>
  </div>
</section>
