---
// @ts-nocheck
import { avatarsImages } from '@/data/images';
import { Icon } from 'astro-icon/components';
import Image from 'astro/components/Image.astro';
import { formatDate } from '@/assets/helpers/format-date';
import Vote from '@/components/base/Vote.astro';

const { text, author, likes, dislikes, title, url, date } = Astro.props;

const avatarImage = avatarsImages[`/src/assets${author.avatar}`]?.default;
---

<article class="comments-card">
  <div class="comments-card__author">
    <Image src={avatarImage} alt={author.login} class="comments-card__avatar" />
    <div class="comments-card__author-text">
      <a href={author.profileUrl} class="comments-card__author-login">
        {author.login}
      </a>
      <time datetime={date} class="comments-card__author-date"
        >{formatDate(date)}</time
      >
    </div>
  </div>
  <h3 class="comments-card__title">
    <a href={url} class="comments-card__link">{title}</a>
  </h3>
  <p class="comments-card__descr">{text}</p>
  <div class="comments-card__bottom">
    <button class="btn-reset comments-card__reply">
      <Icon name="reply" aria-hidden="true" />
      Ответить
    </button>
    <Vote likes={likes} dislikes={dislikes} class="comments-card__vote" />
  </div>
</article>
