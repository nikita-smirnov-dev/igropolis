---
import Button from '@/components/base/Button.astro';
---

<div class="settings">
  <h2 class="settings__title">Настройки</h2>
  <form action="#" class="settings-form" data-settings-password-form>
    <label class="settings-form__label">
      <span class="sr-only">Введите Новый пароль</span>
      <input
        type="password"
        name="new-password"
        placeholder="Новый пароль"
        data-new-password-input
        class="input-reset input settings-form__input"
      />
    </label>
    <label class="settings-form__label">
      <span class="sr-only">Введите Пароль еще раз</span>
      <input
        type="password"
        name="check-password"
        placeholder="Подтверждение пароля"
        data-check-password-input
        class="input-reset input settings-form__input"
      />
    </label>

    <Button variant="primary" type="submit" class="settings-form__btn"
      >Изменить</Button
    >
  </form>
</div>
